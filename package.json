{
  "name": "tether-sync",
  "displayName": "Tether - SSH Sync",
  "description": "Work on any SSH server while every extension runs on your own machine. Two-way file sync, remote terminal and port forwarding. Nothing is installed on the server.",
  "version": "0.4.1",
  "publisher": "filippobrogi00",
  "license": "MIT",
  "homepage": "https://github.com/filippobrogi00/tether#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/filippobrogi00/tether.git"
  },
  "bugs": {
    "url": "https://github.com/filippobrogi00/tether/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "remote",
    "sftp",
    "sync",
    "rsync",
    "tether",
    "remote ssh",
    "server",
    "hpc",
    "deploy",
    "lightweight"
  ],
  "galleryBanner": {
    "color": "#14213D",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "tether.connectFolder",
        "title": "Connect Folder…",
        "category": "Tether"
      },
      {
        "command": "tether.addRemoteServer",
        "title": "Add Remote Server…",
        "category": "Tether"
      },
      {
        "command": "tether.openTerminal",
        "title": "Remote Terminal",
        "category": "Tether"
      },
      {
        "command": "tether.toggleSync",
        "title": "Toggle Sync",
        "category": "Tether"
      },
      {
        "command": "tether.reconnect",
        "title": "Reconnect to Last Used Server",
        "category": "Tether"
      },
      {
        "command": "tether.disconnect",
        "title": "Disconnect",
        "category": "Tether"
      },
      {
        "command": "tether.remoteView",
        "title": "Toggle Remote View",
        "category": "Tether"
      },
      {
        "command": "tether.upload",
        "title": "Upload…",
        "category": "Tether"
      },
      {
        "command": "tether.download",
        "title": "Download…",
        "category": "Tether"
      },
      {
        "command": "tether.relay",
        "title": "Relay…",
        "category": "Tether"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tether.relay",
          "group": "2_workspace@50",
          "when": "resourceScheme == tether"
        },
        {
          "command": "tether.relay",
          "group": "2_workspace@50",
          "when": "resourceScheme == file && tether.hasSession"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Work on a server without installing anything on it.\n[Connect Folder…](command:tether.connectFolder)",
        "when": "workbenchState == empty"
      }
    ],
    "walkthroughs": [
      {
        "id": "tether.start",
        "title": "Get started with Tether",
        "description": "Edit files on a server with all your extensions running locally.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect to your server",
            "description": "Choose which top-level files and folders to sync, then pick a server and a folder. Tether makes a working copy on this computer and keeps both sides in sync.\n[Connect Folder…](command:tether.connectFolder)",
            "media": {
              "markdown": "media/walkthrough-connect.md"
            },
            "completionEvents": [
              "onCommand:tether.connectFolder"
            ]
          },
          {
            "id": "terminal",
            "title": "Run things on the server",
            "description": "Open a terminal that runs on the server, already in your project folder.\n[Remote Terminal](command:tether.openTerminal)",
            "media": {
              "markdown": "media/walkthrough-terminal.md"
            },
            "completionEvents": [
              "onCommand:tether.openTerminal"
            ]
          },
          {
            "id": "status",
            "title": "Watch the status bar",
            "description": "The item at the bottom left always tells you whether you are in sync. Click it for Sync Now, port forwarding, conflicts, and everything else.",
            "media": {
              "markdown": "media/walkthrough-status.md"
            },
            "completionEvents": [
              "onCommand:tether.showMenu"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Tether",
      "properties": {
        "tether.autoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "When you open a paired folder that was still connected last time (you closed the editor without Disconnect), reconnect and sync automatically. Disconnect opts out until you reconnect manually."
        },
        "tether.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules/",
            "bower_components/",
            "jspm_packages/",
            "web_modules/",
            "Pods/",
            "deps/",
            ".venv/",
            "venv/",
            "__pycache__/",
            "__pypackages__/",
            ".eggs/",
            "*.egg-info/",
            ".tox/",
            ".nox/",
            ".hypothesis/",
            ".pytest_cache/",
            ".mypy_cache/",
            ".ruff_cache/",
            ".pytype/",
            ".phpunit.cache/",
            ".ipynb_checkpoints/",
            "htmlcov/",
            ".pdm-build/",
            "pip-wheel-metadata/",
            "**/vendor/bundle/",
            "**/.yarn/cache/",
            "**/.yarn/unplugged/",
            "build/",
            "Build/",
            "builds/",
            "Builds/",
            "target/",
            "dist/",
            "dist-ssr/",
            "dist-types/",
            "dist-cjs/",
            "dist-esm/",
            "dist-es/",
            "dist-newstyle/",
            "out/",
            "output/",
            "_build/",
            ".build/",
            "cmake-build-debug/",
            "cmake-build-release/",
            "cmake-build-relwithdebinfo/",
            "cmake-build-minsizerel/",
            "cmake-build-*/",
            "CMakeFiles/",
            "CMakeScripts/",
            "obj/",
            "Obj/",
            "**/bin/Debug/",
            "**/bin/Release/",
            "**/bin/RelWithDebInfo/",
            "**/bin/MinSizeRel/",
            "x64/",
            "x86/",
            "Win32/",
            "ARM64/",
            "artifacts/",
            "BenchmarkDotNet.Artifacts/",
            "publish/",
            "generated/",
            "generated-sources/",
            "generated-test-sources/",
            "coverage/",
            ".nyc_output/",
            "TestResults/",
            "test-results/",
            "test-output/",
            "lib-cov/",
            "staticfiles/",
            "_site/",
            "_book/",
            "storybook-static/",
            "zig-out/",
            "DerivedData/",
            "DerivedDataCache/",
            "Intermediate/",
            "Binaries/",
            "MemoryCaptures/",
            "tmp/",
            ".tmp/",
            ".temp/",
            ".cache/",
            ".gradle/",
            ".kotlin/",
            ".metals/",
            ".bloop/",
            ".bsp/",
            ".cpcache/",
            ".shadow-cljs/",
            ".next/",
            ".nuxt/",
            ".output/",
            ".svelte-kit/",
            ".angular/",
            ".turbo/",
            ".nx/",
            ".parcel-cache/",
            ".webpack/",
            ".vite/",
            ".swc/",
            ".docusaurus/",
            ".astro/",
            ".expo/",
            ".serverless/",
            ".fusebox/",
            ".rollup.cache/",
            ".dart_tool/",
            ".swiftpm/",
            ".stack-work/",
            ".cabal-sandbox/",
            "elm-stuff/",
            ".spago/",
            "zig-cache/",
            ".zig-cache/",
            "nimcache/",
            ".nimcache/",
            ".godot/",
            ".import/",
            "bazel-bin/",
            "bazel-out/",
            "bazel-testlogs/",
            "bazel-genfiles/",
            "buck-out/",
            ".pants.d/",
            "plz-out/",
            ".terraform/",
            ".terragrunt-cache/",
            "packer_cache/",
            ".vs/",
            ".cxx/",
            ".externalNativeBuild/",
            ".deps/",
            ".libs/",
            "autom4te.cache/",
            "meson-private/",
            "meson-info/",
            "meson-logs/",
            ".jekyll-cache/",
            ".sass-cache/",
            ".lake/",
            ".dub/",
            "cover_db/",
            "blib/",
            "slprj/",
            "sccprj/",
            "codegen/",
            ".Rproj.user/",
            "xcuserdata/",
            ".direnv/",
            ".bundle/",
            "**/storage/framework/cache/",
            "**/storage/framework/sessions/",
            "**/storage/framework/views/",
            "**/bootstrap/cache/",
            "**/var/cache/",
            "**/.vitepress/cache/",
            "**/.vitepress/dist/",
            "**/.vuepress/.cache/",
            "**/.vuepress/.temp/",
            "**/.vuepress/dist/",
            "**/resources/_gen/",
            "**/.meteor/local/",
            "**/Carthage/Build/",
            "**/lib/bs/",
            "/bin/",
            "/Bin/",
            "/debug/",
            "/Debug/",
            "/release/",
            "/Release/",
            "/temp/",
            "/Temp/",
            "/Library/",
            "/library/",
            "/Saved/",
            "/saved/",
            "*.pyc",
            "*.pyo",
            "*.class",
            "*.o",
            "*.lo",
            "*.beam",
            "*.tsbuildinfo",
            ".DS_Store",
            "Thumbs.db",
            "Desktop.ini",
            ".eslintcache",
            ".stylelintcache",
            "CMakeCache.txt",
            ".flutter-plugins",
            ".flutter-plugins-dependencies"
          ],
          "scope": "resource",
          "markdownDescription": "Files and folders that are never synced, in `.gitignore` syntax. The default skips dependency folders, virtual environments, and build and cache directories (`build/`, `target/`, `dist/`, `out/`, and the language-specific caches in the list below). You can also put patterns in a `.tetherignore` or `.connectignore` file in the project root. **Connect Folder…** lists the top-level files and folders first, with build output, caches, and `.git` unchecked, so you can change that for this project before connecting. `.git/` is always skipped; Tether initializes a repository on the server from your local origin instead."
        },
        "tether.respectGitignore": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Also skip everything listed in the project's root `.gitignore`. Off by default because ignored files such as `.env` are often needed on the server."
        },
        "tether.maxFileSizeMB": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "scope": "resource",
          "description": "Files larger than this are left alone on both sides. 0 means no limit."
        },
        "tether.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "resource",
          "description": "How often to look for changes made on the server. Local changes are always sent immediately. 0 turns periodic checks off."
        },
        "tether.conflictPolicy": {
          "type": "string",
          "enum": [
            "ask",
            "preferLocal",
            "preferRemote",
            "keepBoth"
          ],
          "enumDescriptions": [
            "Show the file in the status bar and let me decide.",
            "My version always wins.",
            "The server version always wins.",
            "Keep my version and save the server version next to it."
          ],
          "default": "ask",
          "scope": "resource",
          "description": "What to do when a file was changed both here and on the server."
        },
        "tether.confirmDeletesOver": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "scope": "resource",
          "description": "Ask before one sync deletes more than this many files."
        },
        "tether.concurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 16,
          "scope": "resource",
          "description": "How many files to transfer at the same time."
        },
        "tether.compressTransfers": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Gzip files above a size threshold before sending them over SSH, then decompress on the other side."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p .",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node esbuild.mjs --test && node --test test/planner.test.cjs test/relaySelection.test.cjs test/bootstrap.test.cjs test/gitRemote.test.cjs test/ignore.test.cjs",
    "test:integration": "node esbuild.mjs --test && node --test test/integration.test.cjs",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "test:smoke": "node esbuild.mjs && node esbuild.mjs --test && node --test test/smoke.test.cjs"
  },
  "dependencies": {
    "ignore": "^7.0.14",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
